--- !u!114 &114724920021757396
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1066778049879928}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 708705254, guid: d3e719b59ab71ba3f6b398058c866280, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 0.8}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: f00a7e4e4d96fd54aae2447cdcde6606, type: 3}
    m_FontSize: 11
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 1
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "1、选择对应等阶抽奖，每提升一个等阶消费增加<color=#84FFFF>20</color>灵玉\n2、每1枚灵玉消费记录为1点积分\n3、每100抽必出天阶中品功法，且不会重复出现同一类型功法（例：首次抽出纳气功法后，下一本天阶功法将不再是纳气）\n4、活动持续期间，积分可领取物品。\n5、中奖概率如下： \n       道经残卷*1   \r35%                    地阶经脉丹   2%           \n       道经残卷*3   \r17.5%                 仙金       2%                          \n       陨铁*5            \r21.2%                 德经       1%       \n       悟道石*5        21.2%                 天阶功法       0.1%"
