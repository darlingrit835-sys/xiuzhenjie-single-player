diff --git a/Assets/Scripts/Assembly-CSharp/XiuZhenJie/Crafting/VoidRealmView.Public.cs b/Assets/Scripts/Assembly-CSharp/XiuZhenJie/Crafting/VoidRealmView.Public.cs
