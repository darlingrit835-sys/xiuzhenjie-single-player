diff --git a/Assets/Scripts/Assembly-CSharp/XiuZhenJie/Crafting/VoidRealmView.Workshop.cs b/Assets/Scripts/Assembly-CSharp/XiuZhenJie/Crafting/VoidRealmView.Workshop.cs
