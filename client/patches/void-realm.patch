diff --git a/Assets/Scripts/Assembly-CSharp/XiuZhenJie/Crafting/VoidRealmCareerDesk.cs b/Assets/Scripts/Assembly-CSharp/XiuZhenJie/Crafting/VoidRealmCareerDesk.cs
