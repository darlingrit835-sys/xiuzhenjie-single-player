diff --git a/Assets/Scripts/Assembly-CSharp/XiuZhenJie/Crafting/VoidRealmView.Creation.cs b/Assets/Scripts/Assembly-CSharp/XiuZhenJie/Crafting/VoidRealmView.Creation.cs
