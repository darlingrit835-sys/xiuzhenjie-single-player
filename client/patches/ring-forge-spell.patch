@@ -0,0 +1,343 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using UnityEngine;
+using UnityEngine.Events;
+using UnityEngine.UI;
+
+namespace XiuZhenJie
+{
+	// The ring owns its presentation order. Never reorder the server snapshot used by inventory sync.
+	internal sealed class RingLedger
+	{
+		private static readonly string[] Sections = { "全部", "法器", "材料", "典籍", "丹符", "奇物" };
+		private static readonly string[] Sorts = { "按品阶", "按数量", "按单价", "按名称" };
+		private static readonly string[] States = { "全部状态", "可出售", "已锁定", "已认主", "使用中" };
+		private const float RowHeight = 54f;
+		private readonly NaJieSpacePanel panel;
+		private readonly ScrollRect scroll;
+		private readonly Text summary, empty, saleCaption, upgradeCaption;
+		private readonly Button sortButton, stateButton;
+		private readonly List<Button> tabs = new List<Button>();
+		private readonly Dictionary<string, Row> rows = new Dictionary<string, Row>();
+		private readonly HashSet<string> marked = new HashSet<string>();
+		private readonly InputField search;
+		private readonly Action<BaseNaJieGoodEntity, GameObject> inspect;
+		private List<BaseNaJieGoodEntity> items = new List<BaseNaJieGoodEntity>();
+		private List<BaseNaJieGoodEntity> sectionItems = new List<BaseNaJieGoodEntity>();
+		private int category, sort, state;
+		private bool guide;
+		internal bool Choosing { get; private set; }
+		internal Button PracticeBook { get; private set; }
+		internal IEnumerable<BaseNaJieGoodEntity> Selected => items.Where(g => marked.Contains(g.GoodsId) && CanChoose(g));
+		private Font Font => panel.RongLiangText.font;
+
+		private sealed class Row
+		{
+			internal Button Button;
+			internal Image Icon;
+			internal Text Name, Detail, Count, State;
+			internal BaseNaJieGoodEntity Item;
+		}
+
+		internal RingLedger(NaJieSpacePanel panel, Action<BaseNaJieGoodEntity, GameObject> inspect)
+		{
+			this.panel = panel;
+			this.inspect = inspect;
+			scroll = panel.NaJieListConstant.GetComponentInParent<ScrollRect>();
+			panel.NaJieListConstant.GetComponent<GridLayoutGroup>().enabled = false;
+			var infinite = panel.NaJieListConstant.GetComponent<ScrollViewInfiniteContent>();
+			if (infinite != null) infinite.enabled = false;
+			InkDialogArt.Inset((RectTransform)scroll.transform, 5f, 5f, 171f, 53f);
+			saleCaption = panel.YiJianChuShouBtn.GetComponentInChildren<Text>();
+			upgradeCaption = panel.ShengJiBtn.GetComponentInChildren<Text>();
+			var input = DefaultControls.CreateInputField(new DefaultControls.Resources());
+			input.name = "GoodsSearch";
+			input.transform.SetParent(panel.transform, false);
+			input.layer = panel.gameObject.layer;
+			Place((RectTransform)input.transform, 0, 1, 7, -92, 73, 33);
+			search = input.GetComponent<InputField>();
+			InkInterfaceArt.Set(search.image, "ParchmentHeading", false);
+			var hint = (Text)search.placeholder;
+			hint.text = "搜名称、五行或品阶";
+			hint.fontStyle = FontStyle.Normal;
+			hint.color = InkInterfaceArt.SoftInk;
+			search.textComponent.color = InkInterfaceArt.Ink;
+			foreach (var text in input.GetComponentsInChildren<Text>())
+			{
+				text.gameObject.layer = input.layer;
+				text.font = Font;
+				text.fontSize = 13;
+				text.raycastTarget = false;
+				InkDialogArt.Inset(text.rectTransform, 9, 8, 0, 0);
+			}
+			search.onValueChanged.AddListener(_ => Redraw(true));
+			sortButton = Control(panel.transform, "SortOrder", Sorts[0], () => {
+				sort = (sort + 1) % Sorts.Length;
+				Redraw(true);
+			});
+			Place((RectTransform)sortButton.transform, 1, 1, -88, -7, 73, 33);
+			var artwork = Singleton<FacadeManager>.Instance.SelectGoodsSprite();
+			int[] sectionArt = { 0, 15, 13, 1, 19, 34 };
+			for (int i = 0; i < Sections.Length; i++)
+			{
+				int tab = i;
+				var button = Control(panel.transform, "Section" + i, Sections[i], () => {
+					category = tab;
+					Redraw(true);
+				});
+				Place((RectTransform)button.transform, i/(float)Sections.Length, (i+1f)/Sections.Length,
+					i == 0 ? 7 : 2, i == Sections.Length-1 ? -7 : -2, 110, 32);
+				var symbol = Node(button.transform, "SectionArt").AddComponent<Image>();
+				symbol.sprite = artwork.TryGetValue(sectionArt[i], out var sprite) && sprite != null ? sprite : InkInterfaceArt.Get("Satchel");
+				symbol.raycastTarget = false;
+				symbol.preserveAspect = true;
+				Place(symbol.rectTransform, 0, 0, 3, 21, 7, 18);
+				InkDialogArt.Inset(button.GetComponentInChildren<Text>().rectTransform, 21, 2, 0, 0);
+				tabs.Add(button);
+			}
+			summary = Label(panel.transform, "Summary", 12, TextAnchor.MiddleLeft);
+			Place(summary.rectTransform, 0, 1, 11, -95, 144, 26);
+			stateButton = Control(panel.transform, "ItemState", States[0], () => {
+				state = (state + 1) % States.Length;
+				Redraw(true);
+			});
+			Place((RectTransform)stateButton.transform, 1, 1, -88, -7, 144, 26);
+			empty = Label(scroll.transform, "NoMatchingGoods", 14, TextAnchor.MiddleCenter);
+			InkDialogArt.Inset(empty.rectTransform, 15, 15, 0, 0);
+			empty.gameObject.SetActive(false);
+		}
+
+		internal static int Section(int type)
+		{
+			switch (type)
+			{
+				case 14: case 15: case 16: case 26: case 29: return 1;
+				case 7: case 8: case 9: case 10: case 11: case 12: case 13:
+				case 22: case 23: case 24: case 35: case 40: return 2;
+				case 1: case 2: case 3: case 4: case 5: case 6:
+				case 17: case 18: case 33: case 39: case 41: return 3;
+				case 19: case 20: case 21: case 38: return 4;
+				default: return 5;
+			}
+		}
+
+		internal static Sprite Artwork(BaseNaJieGoodEntity g)
+		{
+			string asset = null;
+			if (!string.IsNullOrEmpty(g.BlankId))
+				asset = ForgeWorkshop.PatternArt(g.BlankId);
+			else if (g.TemplateId == "eq_armor_qingbu")
+				asset = "Robe";
+			if (asset != null)
+			{
+				var painting = InkInterfaceArt.Get("Goods/" + asset);
+				if (painting != null) return painting;
+			}
+			var icons = Singleton<FacadeManager>.Instance.SelectGoodsSprite();
+			return icons.TryGetValue(g.Type, out var icon) && icon != null ? icon : InkInterfaceArt.Get("Satchel");
+		}
+
+		internal static string Kind(int type)
+		{
+			switch (type)
+			{
+				case 1: return "功法"; case 2: return "丹方"; case 3: return "阵图"; case 4: case 17: case 18: return "器图";
+				case 5: return "符书"; case 6: return "法术书"; case 7: return "兽材"; case 8: return "皮毛";
+				case 9: return "精血"; case 10: return "兽骨"; case 11: return "妖丹"; case 12: return "灵植";
+				case 13: return "矿材"; case 14: return "法器"; case 15: return "兵器"; case 16: case 26: return "防具";
+				case 19: return "丹药"; case 20: return "阵盘"; case 21: case 38: return "符箓";
+				case 22: return "符笔"; case 23: return "符纸"; case 24: return "符墨"; case 25: return "工具";
+				case 29: return "足具"; case 28: case 30: case 31: case 32: return "秘境";
+				case 33: case 39: case 41: return "经卷"; case 34: return "悟道石"; case 35: return "陨铁";
+				case 36: case 37: return "傀儡"; case 40: return "仙金"; case 99: return "灵玉"; case 100: return "灵石";
+				default: return "奇物";
+			}
+		}
+
+		internal static string Status(BaseNaJieGoodEntity g)
+		{
+			var parts = new List<string>(3);
+			if (g.IsUsing) parts.Add("使用中");
+			if (g.IsLock) parts.Add("已锁定");
+			if (g.IsBinding) parts.Add("已认主");
+			return string.Join("·", parts);
+		}
+
+		internal static bool Tradeable(BaseNaJieGoodEntity g) => !g.IsLock && !g.IsUsing && !g.IsBinding;
+		private bool CanChoose(BaseNaJieGoodEntity g) => Tradeable(g) && !(guide && PracticeGuideFlow.IsStarter(g));
+
+		internal void SetItems(List<BaseNaJieGoodEntity> all, List<BaseNaJieGoodEntity> filtered, bool guiding)
+		{
+			items = all ?? new List<BaseNaJieGoodEntity>();
+			sectionItems = filtered;
+			guide = guiding;
+			foreach (var id in rows.Keys.Except(items.Select(g => g.GoodsId)).ToList())
+			{
+				rows[id].Button.gameObject.SetActive(false);
+				UnityEngine.Object.Destroy(rows[id].Button.gameObject);
+				rows.Remove(id);
+			}
+			marked.IntersectWith(items.Where(CanChoose).Select(g => g.GoodsId));
+			Redraw(false);
+		}
+
+		internal void SetChoosing(bool value)
+		{
+			Choosing = value;
+			marked.Clear();
+			Redraw(false);
+		}
+
+		private bool MatchesState(BaseNaJieGoodEntity g)
+		{
+			switch (state)
+			{
+				case 1: return CanChoose(g); case 2: return g.IsLock;
+				case 3: return g.IsBinding; case 4: return g.IsUsing;
+				default: return true;
+			}
+		}
+
+		private void Redraw(bool top)
+		{
+			string query = search.text.Trim();
+			IEnumerable<BaseNaJieGoodEntity> visible = sectionItems.Where(g => (category == 0 || Section(g.Type) == category) && MatchesState(g));
+			if (query.Length > 0)
+			{
+				visible = visible.Where(g => string.Join(" ", g.Name, Kind(g.Type), WorldSetting.GetRankAllName(g.Rank),
+					WorldSetting.GetSignleWuXingName((WuXing)g.FiveElement), Status(g)).IndexOf(query, StringComparison.OrdinalIgnoreCase) >= 0);
+			}
+			var ordered = visible.OrderByDescending(g => guide && PracticeGuideFlow.IsStarter(g));
+			switch (sort)
+			{
+				case 0: ordered = ordered.ThenByDescending(g => g.Rank).ThenByDescending(g => g.Level); break;
+				case 1: ordered = ordered.ThenByDescending(g => g.GoodsNum); break;
+				case 2: ordered = ordered.ThenByDescending(g => g.RecyclePrice); break;
+			}
+			var shown = ordered.ThenBy(g => g.Name, StringComparer.Ordinal).ThenBy(g => g.GoodsId, StringComparer.Ordinal).ToList();
+			var visibleIds = new HashSet<string>(shown.Select(g => g.GoodsId));
+			foreach (var existing in rows)
+				if (existing.Value.Button.gameObject.activeSelf && !visibleIds.Contains(existing.Key))
+					existing.Value.Button.gameObject.SetActive(false);
+			PracticeBook = null;
+			for (int i = 0; i < shown.Count; i++)
+			{
+				var g = shown[i];
+				if (!rows.TryGetValue(g.GoodsId, out var row))
+				{
+					row = NewRow();
+					rows.Add(g.GoodsId, row);
+				}
+				row.Item = g;
+				row.Button.gameObject.SetActive(true);
+				Place((RectTransform)row.Button.transform, 0, 1, 5, -5, 4 + RowHeight*i, RowHeight-3);
+				bool chosen = marked.Contains(g.GoodsId);
+				InkInterfaceArt.Set(row.Button.image, chosen ? "JadeSelection" : "LightPaper", false);
+				row.Button.interactable = !Choosing || CanChoose(g);
+				row.Icon.sprite = Artwork(g);
+				row.Name.text = g.Name;
+				row.Count.text = "×" + g.GoodsNum;
+				row.Detail.text = Kind(g.Type) + " · " + WorldSetting.GetRankAllName(g.Rank) + " · " + (g.FiveElement >= 1 && g.FiveElement <= 5 ? g.GetFiveElementName() + "行" : "无属");
+				var status = Status(g);
+				row.State.text = chosen ? "已勾选" : status.Length > 0 ? status : (Choosing ? "可勾选" : $"单价 {g.RecyclePrice} 灵石");
+				row.State.color = chosen || status.Length > 0 ? InkInterfaceArt.Seal : InkInterfaceArt.SoftInk;
+				if (PracticeGuideFlow.IsStarter(g)) PracticeBook = row.Button;
+			}
+			panel.NaJieListConstant.SetSizeWithCurrentAnchors(RectTransform.Axis.Vertical, 8 + shown.Count*RowHeight);
+			if (top)
+			{
+				scroll.StopMovement();
+				var content = panel.NaJieListConstant;
+				content.anchoredPosition = new Vector2(content.anchoredPosition.x, 0f);
+			}
+			for (int i = 0; i < tabs.Count; i++)
+			{
+				var current = category == i;
+				InkDialogArt.StyleButton(tabs[i], current ? "JadeButton" : "LightPlaque", current ? InkDialogArt.Ivory : InkInterfaceArt.Ink);
+			}
+			sortButton.GetComponentInChildren<Text>().text = Sorts[sort];
+			stateButton.GetComponentInChildren<Text>().text = States[state];
+			long quantity = shown.Sum(g => (long)g.GoodsNum);
+			long selected = Selected.Sum(g => (long)g.GoodsNum);
+			summary.text = Choosing ? $"已选 {selected} 件 · {Selected.Sum(g => (decimal)g.RecyclePrice * g.GoodsNum)} 灵石" : $"{Sections[category]} · {shown.Count} 格 / {quantity} 件";
+			saleCaption.text = Choosing ? "确认出售" : "选物出售";
+			upgradeCaption.text = Choosing ? "取消选择" : "扩充纳戒";
+			panel.YiJianChuShouBtn.interactable = !Choosing || selected > 0;
+			empty.text = items.Count == 0 ? "纳戒中暂无物品" : "没有符合条件的物品";
+			empty.gameObject.SetActive(shown.Count == 0);
+		}
+
+		private Row NewRow()
+		{
+			var row = new Row();
+			var obj = Node(panel.NaJieListConstant, "GoodsRow");
+			row.Button = obj.AddComponent<Button>();
+			row.Button.targetGraphic = obj.AddComponent<Image>();
+			row.Button.onClick.AddListener(() => {
+				if (!Choosing) { inspect(row.Item, obj); return; }
+				if (!marked.Add(row.Item.GoodsId)) marked.Remove(row.Item.GoodsId);
+				Redraw(false);
+			});
+			row.Icon = Node(obj.transform, "Artwork").AddComponent<Image>();
+			row.Icon.preserveAspect = true;
+			row.Icon.raycastTarget = false;
+			Place(row.Icon.rectTransform, 0, 0, 5, 50, 3, 45);
+			row.Name = Label(obj.transform, "Name", 16, TextAnchor.MiddleLeft);
+			row.Name.fontStyle = FontStyle.Bold;
+			Place(row.Name.rectTransform, 0, 1, 56, -64, 3, 24);
+			row.Detail = Label(obj.transform, "Attributes", 12, TextAnchor.MiddleLeft);
+			Place(row.Detail.rectTransform, 0, 1, 56, -91, 27, 20);
+			row.Count = Label(obj.transform, "Quantity", 15, TextAnchor.MiddleRight);
+			Place(row.Count.rectTransform, 1, 1, -61, -8, 3, 24);
+			row.State = Label(obj.transform, "State", 11, TextAnchor.MiddleRight);
+			Place(row.State.rectTransform, 1, 1, -90, -8, 27, 20);
+			return row;
+		}
+
+		private static GameObject Node(Transform parent, string name)
+		{
+			var obj = new GameObject(name, typeof(RectTransform));
+			obj.layer = parent.gameObject.layer;
+			obj.transform.SetParent(parent, false);
+			return obj;
+		}
+
+		private Text Label(Transform parent, string name, int size, TextAnchor align)
+		{
+			var text = Node(parent, name).AddComponent<Text>();
+			text.font = Font;
+			text.fontSize = size;
+			text.resizeTextForBestFit = true;
+			text.resizeTextMinSize = Mathf.Min(11, size);
+			text.resizeTextMaxSize = size;
+			text.supportRichText = false;
+			text.color = InkInterfaceArt.Ink;
+			text.alignment = align;
+			text.raycastTarget = false;
+			return text;
+		}
+
+		private Button Control(Transform parent, string name, string title, UnityAction click)
+		{
+			var obj = Node(parent, name);
+			var image = obj.AddComponent<Image>();
+			var button = obj.AddComponent<Button>();
+			button.targetGraphic = image;
+			var caption = Label(obj.transform, "Caption", 14, TextAnchor.MiddleCenter);
+			caption.text = title;
+			InkDialogArt.Inset(caption.rectTransform, 2, 2, 0, 0);
+			InkDialogArt.StyleButton(button, "LightPlaque", InkInterfaceArt.Ink);
+			button.onClick.AddListener(click);
+			return button;
+		}
+
+		private static void Place(RectTransform rect, float from, float to, float left, float right, float top, float height)
+		{
+			rect.anchorMin = new Vector2(from, 1);
+			rect.anchorMax = new Vector2(to, 1);
+			rect.offsetMin = new Vector2(left, -top-height);
+			rect.offsetMax = new Vector2(right, -top);
+		}
+	}
+}
