+		internal static int ReadElixirShield(ByteString reply)
+		{
+			var input = reply.CreateCodedInput();
+			uint tag;
+			while ((tag = input.ReadTag()) != 0)
+			{
+				if (tag == 232) return Math.Max(0, input.ReadInt32());
+				input.SkipLastField();
+			}
+			return 0;
