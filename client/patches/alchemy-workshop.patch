diff --git a/Assets/Scripts/Assembly-CSharp/XiuZhenJie/Crafting/AlchemyRecipeBook.cs b/Assets/Scripts/Assembly-CSharp/XiuZhenJie/Crafting/AlchemyRecipeBook.cs
