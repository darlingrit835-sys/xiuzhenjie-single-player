+        internal static int DungeonVigor(string mapId)
+        {
+            if (string.IsNullOrEmpty(mapId)) return 2;
+            int mark = mapId.IndexOf('W');
+            if (mark < 0 || mark + 3 != mapId.Length) return 2;
+            return mapId[mark + 2] == '3' ? 6 : mapId[mark + 2] == '2' ? 4 : 2;
+        }
