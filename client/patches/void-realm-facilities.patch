+            {
+                if(this==null||suspended||mine!=ticket)return;
+                busy=false;
+                if(r==null) {feedback=error;confirm="";}
+                else accept(r);
+                Render();
+            });
+        }
+        void Render()
+        {
+            Clear(controls);Clear(body);
+            Label(controls,"合道台",.05f,.82f,.59f,.98f,31,Cream);
