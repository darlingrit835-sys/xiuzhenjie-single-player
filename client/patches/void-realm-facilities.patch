+            }
+            else
+            {
+                int n=state.books==null?0:state.books.Count(b=>b.free>0);
+                Label(body,n==0?"纳戒暂无可投入的典籍。可先抄两本基础功法，再回书案选卷。":
+                    "从纳戒各置一册。主卷生参卷得三点道意，同源得两点，逆序相生得一点。",.02f,.49f,.98f,.81f,19,Ink);
