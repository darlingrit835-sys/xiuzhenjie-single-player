+        }
+        void DrawPending()
+        {
+            Label(body,"上次书案回执",.02f,.72f,.98f,.94f,25,Ink);
+            Label(body,feedback.Length>0?feedback:"有一笔操作尚待核对。按原单查询即可确认结果。",.02f,.40f,.98f,.72f,18,Muted);
