index 0000000000000000000000000000000000000000..337a71806f5156a42c09152d4fa0e73737bfcdbf
--- /dev/null
+++ b/Assets/Resources/AuctionHall/GuideLines.json
@@ -0,0 +1,204 @@
+{
+  "groups": [
+    {
+      "key": "market",
+      "lines": [
+        "坊市开着门。看中哪件，先点开价签细瞧。",
+        "寻功法的往书册里翻，寻趁手家伙的看法器一栏。",
+        "柜上明码标价，买前把件数和总价各瞧一眼。",
+        "要出手纳戒里的物件，自己定好价，便可挂到行里。",
+        "买过的东西不必凭记性，翻开买入簿就能查账。"
+      ]
+    },
+    {
+      "key": "collect",
+      "lines": [
+        "纳戒里有物要送拍，先拣出来，写下起拍总价。",
+        "本场收宝，正册只收{limit}件，送来还须过一回甄选。",
+        "掌柜排册先看品阶，再看等级，两样都同才论先后。",
+        "一位道友一场可送三件，哪件上台，且斟酌好。",
+        "落选的物件会送到交割处，腾好纳戒就能领回。"
+      ]
+    },
+    {
+      "key": "preview",
+      "lines": [
+        "图录已摊开，点一件拍品，就能细看它的起价与加价幅度。",
+        "掌柜照册逐件唱宝。记下心仪之物的次序，入场好寻。",
+        "先翻全册，再分灵石；前一件押下的款，下一件便不能再用。",
+        "赶不上开槌也无妨，预展时就能给中意的物件留价。",
+        "拍签上写着谁家送来的货，商会补上的拍品也在册中。"
+      ]
+    },
+    {
+      "key": "proxy",
+      "lines": [
+        "先定你肯出的最高数，商会按这个数收下押款。",
+        "只有一面牌应价，就按起价领拍；委托上限仍替你守着。",
+        "若是你在领价，再抬高上限，只补新旧两数的差额。",
+        "别家的牌越过你的上限，原先押着的灵石就退回钱包。",
+        "槌落时照成交价记账，多押的灵石随即退还。"
+      ]
+    },
+    {
+      "key": "liveWait",
+      "lines": [
+        "请看拍签上的登台次序，好物各有轮次。",
+        "席间未唱价，正好核一核手中可用的灵石。",
+        "散席也能举牌。要添果盘、点灵酒，再唤掌柜。",
+        "想听个明白，拍台下方留着掌柜的唱词。",
+        "买卖有了着落，记得往交割处走一趟，再收宝入戒。"
+      ]
+    },
+    {
+      "key": "openBook",
+      "lines": [
+        "书匣开了，请诸位先认卷名——《{name}》。",
+        "这一席轮到《{name}》。有寻典籍的道友么？",
+        "掌柜翻到书目这一页，《{name}》请上拍台。",
+        "要为藏书添一卷的，请看《{name}》的拍签。",
+        "且把旁册合上，眼下只唱《{name}》这一卷。"
+      ]
+    },
+    {
+      "key": "openRecipe",
+      "lines": [
+        "方谱一席有请，拍签上的名字是《{name}》。",
+        "想添一份方谱的道友，请细看《{name}》。",
+        "台上换了谱册。《{name}》，现在开始应价。",
+        "诸位先认清图谱的名目，再为《{name}》举牌。",
+        "这回拍的是《{name}》这份图谱，请看起价。"
+      ]
+    },
+    {
+      "key": "openPill",
+      "lines": [
+        "药案已备，{name}共{count}份，合在这一拍。",
+        "诸位若在寻丹药，这一席是{name}。",
+        "掌柜点过数了，{name}按拍签所列整份起拍。",
+        "先认药名，再看价签。此拍为{name}。",
+        "请把丹药一栏翻到{name}，台上正唱到它。"
+      ]
+    },
+    {
+      "key": "openGear",
+      "lines": [
+        "器架移到台前，台上这件唤作{name}。",
+        "挑器物讲究合手，诸位且细看{name}。",
+        "{name}这便开拍。先看品阶，再想想愿出多少。",
+        "掌柜已把{name}列上器物席，诸位可以举牌了。",
+        "是拿来佩用，还是留作收藏？{name}请诸位掌眼。"
+      ]
+    },
+    {
+      "key": "openTalisman",
+      "lines": [
+        "符匣启封，这一拍是{name}。",
+        "符箓席请看过来，{name}共{count}张，一并叫价。",
+        "要添符箓的道友，先认清{name}的品阶。",
+        "掌柜照符册唱名，{name}，现在请价。",
+        "请将目光移到符签上，眼下这件是{name}。"
+      ]
+    },
+    {
+      "key": "openArray",
+      "lines": [
+        "阵盘登台，掌柜先报其名——{name}。",
+        "懂阵的道友请掌眼，今次起拍的是{name}。",
+        "阵法图录已翻到{name}，有意应价的请细看。",
+        "这一席留给{name}。看清拍签，即可应价。",
+        "要给阵具添一件的道友，请先过目{name}。"
+      ]
+    },
+    {
+      "key": "openMaterial",
+      "lines": [
+        "料盘上案，{name}共{count}份，按整批唱价。",
+        "认准料名再举牌。这一拍是{name}。",
+        "备料的道友请看，{name}已列在台前。",
+        "掌柜再报一次件数，{name}计{count}份。",
+        "先掂量手头缺多少料，再看这批{name}值几何。"
+      ]
+    },
+    {
+      "key": "openOther",
+      "lines": [
+        "下一席正是{name}，请诸位先看拍签。",
+        "掌柜依册唱名，{name}上台。",
+        "候着{name}的道友，现在可以亮牌了。",
+        "请看台心的{name}，品阶与数量都列在签上。",
+        "这件{name}现已开拍，散席雅间皆可举牌。"
+      ]
+    },
+    {
+      "key": "firstBid",
+      "lines": [
+        "头一面牌举起来了，{name}应价{price}灵石！",
+        "{leader}先开了价，{name}，{price}灵石。",
+        "{name}有了头价！掌柜记下{price}灵石。",
+        "头价定在{price}灵石。想接{name}的，下一牌请加价。",
+        "掌柜瞧见了！{name}，首价{price}灵石。"
+      ]
+    },
+    {
+      "key": "leading",
+      "lines": [
+        "{leader}的牌在前，{name}现价{price}灵石。",
+        "价签翻新，{name}已到{price}灵石，诸位可看清了？",
+        "{name}眼下由{leader}领价，数目是{price}灵石。",
+        "掌柜再报台面价，{name}，{price}灵石。",
+        "有意跟价的请留意，{name}要从{price}灵石往上加。"
+      ]
+    },
+    {
+      "key": "firstCall",
+      "lines": [
+        "第一声，{name}，{price}灵石！还有道友应价么？",
+        "{name}且唱一声，台上记的是{price}灵石。",
+        "掌柜头回询价，{name}已到{price}灵石。",
+        "一问诸席，{name}，{price}灵石，可有人接牌？",
+        "{price}灵石，头一遍。{name}仍在台上。"
+      ]
+    },
+    {
+      "key": "secondCall",
+      "lines": [
+        "第二声！{name}，{price}灵石。",
+        "{name}，台面价{price}灵石。这是第二遍唱价。",
+        "掌柜唱到第二声。{name}，还有牌高过{price}灵石么？",
+        "二问雅间散席，有谁接{name}这面牌？现价{price}灵石。",
+        "{price}灵石，第二遍。中意{name}的道友请留神。"
+      ]
+    },
+    {
+      "key": "finalCall",
+      "lines": [
+        "最后一声，{name}，{price}灵石！",
+        "{name}将要落槌，台面价{price}灵石。",
+        "槌已举起，{name}，{price}灵石，还有末一牌么？",
+        "槌还在手。肯为{name}再添一价的，请过{price}灵石！",
+        "{price}灵石，末遍！{name}就等这一槌。"
+      ]
+    },
+    {
+      "key": "sold",
+      "lines": [
+        "落槌！{name}归{leader}，成交{price}灵石。",
+        "{name}以{price}灵石定下，恭请得主前往交割处。",
+        "这一席唱罢，{leader}以{price}灵石拍得{name}。",
+        "成交簿记下了，{name}，{price}灵石。",
+        "槌声落了。{name}成交{price}灵石，买主请收宝。"
+      ]
+    },
+    {
+      "key": "passed",
+      "lines": [
+        "未见举牌，{name}此席流拍。",
+        "{name}问过诸席，无人应价，掌柜收签。",
+        "无人接这一拍，{name}封匣撤台。",
+        "应价时辰已到，{name}仍无领牌，此拍作罢。",
+        "拍簿记一笔流拍。{name}无人出价。"
+      ]
+    }
+  ]
+}
