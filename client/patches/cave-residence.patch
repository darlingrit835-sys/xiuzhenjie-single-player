+
+        private void Load()
+        {
+            int ticket = ++session;
+            string role = roleId;
+            actual = -1;
+            busy = true;
+            readFailed = false;
+            Draw();
+            if (Singleton<NetManager>.Instance.TrySendGameRequest(MsgType.ENTER_DONGFU, null, bytes =>
