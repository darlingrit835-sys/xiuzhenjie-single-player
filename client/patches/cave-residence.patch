diff --git a/Assets/Scripts/Assembly-CSharp/XiuZhenJie/Cultivation/CaveChamberEffects.cs b/Assets/Scripts/Assembly-CSharp/XiuZhenJie/Cultivation/CaveChamberEffects.cs
