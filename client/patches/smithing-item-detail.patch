+		private static void AppendSmithingDetail(ByteString bytes, List<string> rows, UnityAction<List<string>> done)
+		{
+			if (done == null) return;
+			var input = bytes.CreateCodedInput();
+			uint tag;
+			while ((tag = input.ReadTag()) != 0)
+			{
+				if (tag != 146) // length-delimited field 18, optional public template ID
+				{
+					input.SkipLastField();
+					continue;
+				}
+				string templateId = input.ReadString();
+				rows.Add("模板编号," + templateId + ",可在奇珍阁按完整编号查找同一模板的挂牌。");
+				string request = JsonUtility.ToJson(new SmithingTemplateQuery { templateId = templateId });
+				ForgeWire.Send(MsgType.ForgeItemDetail, request, (ok, json) =>
+				{
+					var detail = ok ? JsonUtility.FromJson<SmithingTemplateDetail>(json) : null;
+					if (detail != null)
+					{
+						rows.Add("阴阳," + detail.polarityName + ",法器的阴阳偏性。");
+						rows.Add("气," + detail.qiName + ",法器对应的十二气。");
+						rows.Add("基础攻击," + detail.baseAttack + ",创制时记入模板的攻击值。");
+						rows.Add("基础防御," + detail.baseDefense + ",创制时记入模板的防御值。");
+						if (!string.IsNullOrEmpty(detail.bonusText))
+						{
+							foreach (string affix in detail.bonusText.Split(new[] { '\n', '·', '；', ';', '、' }, System.StringSplitOptions.RemoveEmptyEntries))
+								rows.Add("词条," + affix.Trim().Replace(',', '，') + ",此模板的实际加成。");
+						}
+					}
+					done(rows);
+				});
+				return;
+			}
+			done(rows);
