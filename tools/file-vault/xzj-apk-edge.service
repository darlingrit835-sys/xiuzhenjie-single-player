[Unit]
Description=Xiuzhenjie stable HTTPS APK entry point
After=network.target xzj-apk-latest.service
Wants=xzj-apk-latest.service

[Service]
User=xzj-apk-edge
Group=xzj-apk-edge
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/opt/xzj-apk-share/apk-edge -listen :80 -origin 127.0.0.1:18195 -public-url https://82.156.174.166:80/ -pem /var/lib/xzj-apk-edge/site.pem -webroot /var/lib/xzj-apk-acme-http
Restart=on-failure
RestartSec=3s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=128M

[Install]
WantedBy=multi-user.target
